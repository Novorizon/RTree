<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SourceDirectory Condition="'$(SourceDirectory)' == ''">$(MSBuildProjectDirectory)/../../RTree</SourceDirectory>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SourceDirectory</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(SourceDirectory)'))</_Parameter2>
    </AssemblyAttribute>
    <Compile Include="$(SourceDirectory)/*.cs" Link="RTree/%(Filename)%(Extension)" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
