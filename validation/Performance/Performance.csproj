<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SourceDirectory Condition="'$(SourceDirectory)' == ''">$(MSBuildProjectDirectory)/../../RTree</SourceDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SourceDirectory)/*.cs" Link="RTree/%(Filename)%(Extension)" />
    <Compile Include="Program.cs" />
    <AssemblyMetadata Include="RTreeSourceDirectory" Value="$(SourceDirectory)" />
  </ItemGroup>
</Project>
